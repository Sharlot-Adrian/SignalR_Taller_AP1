@page
@{
    ViewData["Title"] = "Pedidos en Vivo";
}

<h1>Pedidos en Tiempo Real</h1>
@*Nombre*@
<div>
    <label for="userInput">Nombre del Cliente</label>
    <input id="userInput" maxlength="40" />
</div>
@*Estado*@
<div>
    <label for="estadoPedido">Seleccione el estado: </label>
    <select id="estadoPedido" name="estado">
        <option value="Pendiente">Pendiente</option>
        <option value="En Preparacion">En Preparaci&oacute;n</option>
        <option value="Enviado">Enviado</option>
        <option value="Entregado">Entregado</option>
    </select>
</div>
@*Total*@
<div>
    <label for="totalInput">Total</label>
    <input id="totalInput" type="number" step="0.01"/>
</div>

<button id="sendButton" disabled>
    Enviar
</button>
<p id="status">Conectando...</p>

@*Lista mensajes*@
<ul id="messagesList"></ul>

<script src="~/js/pedidos/dist/browser/pedidos.min.js"></script>
<script src="~/js/pedido.js">